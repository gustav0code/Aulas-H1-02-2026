            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "preco": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "estoque": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "codigoProduto": {
            "minLength": 1,
            "type": "string"
          }
        },
